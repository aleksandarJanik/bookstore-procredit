{
  "Authentication": {
    "RequireHttpsMetadata": false
  },
  "ManagementClient": {
    "ApiBaseUrl": "http://localhost:5056",
    "TokenEndpoint": "http://localhost:8080/realms/bookstore/protocol/openid-connect/token",
    "ClientId": "bookstore-service",
    "ClientSecret": "bookstore-service-local-secret"
  },
  "Database": {
    "ApplyMigrations": true,
    "SeedData": true
  },
  "Swagger": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
